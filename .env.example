# ==== LLM（OpenAI 兼容接口，推荐 DeepSeek）====
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ==== 搜索 Agent（可选：bocha / tavily / none，默认 none 时只用定向爬虫）====
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# ==== 运行 ====
DB_PATH=data/job.db
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
JOB_MAX_AGE_DAYS=30
# 首次访问时若当天没有成功采集，后台补一轮（免费实例休眠场景）
LAZY_CRAWL_ENABLED=1
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ==== Docker Compose（可选）====
HOST_PORT=8000
DATA_DIR=./data
LOG_DIR=./logs
